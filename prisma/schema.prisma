generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  PACKAGE_ONLY
  CAMPAIGN_ONLY
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum CampaignStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  DISABLED
}

enum CampaignRuleType {
  BASE_PRICE
  FIXED_PRICE
  PERCENT_DISCOUNT
  TWO_FOR_ONE
  THREE_FOR_TWO
}

enum CampaignAudience {
  ADULT
  CHILD
  INFANT
  ALL
}

enum CampaignCategory {
  PRICE
  CONTENT
  MIXED
}

enum CampaignEffectMode {
  MERGE
  REPLACE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id       String  @id @default(uuid())
  code     String  @unique
  isActive Boolean @default(true)

  adultPriceMXN  Int
  childPriceMXN  Int @default(0)
  infantPriceMXN Int @default(0)

  currency String @default("MXN")

  maxAdults   Int?
  maxChildren Int?
  maxInfants  Int?

  ageRules Json?

  translations PackageTranslation[]
  extras       PackageExtra[]
  campaigns    Campaign[]
  reservations Reservation[]
  coupons      Coupon[]

  coverMediaId String?
  coverMedia   MediaAsset? @relation("PackageCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PackageTranslation {
  id          String  @id @default(uuid())
  packageId   String
  lang        String
  name        String
  description String?

  includes Json?
  excludes Json?
  notes    Json?

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, lang])
}

model PackageExtra {
  id         String  @id @default(uuid())
  packageId  String
  code       String
  priceMXN   Int
  currency   String  @default("MXN")
  isRequired Boolean @default(false)
  isActive   Boolean @default(true)

  translations PackageExtraTranslation[]
  package      Package                   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, code])
}

model PackageExtraTranslation {
  id          String  @id @default(uuid())
  extraId     String
  lang        String
  name        String
  description String?

  extra PackageExtra @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@unique([extraId, lang])
}

model Campaign {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  source   String?
  isActive Boolean @default(true)

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  description String?

  status   CampaignStatus   @default(SCHEDULED)
  category CampaignCategory @default(PRICE)
  ruleType CampaignRuleType @default(BASE_PRICE)
  audience CampaignAudience @default(ALL)

  startAt DateTime?
  endAt   DateTime?

  priority  Int     @default(0)
  autoApply Boolean @default(true)
  stackable Boolean @default(false)

  fixedAdultPriceMXN  Int?
  fixedChildPriceMXN  Int?
  fixedInfantPriceMXN Int?

  discountPercent Int?

  payQty  Int?
  takeQty Int?

  minAdults   Int?
  minChildren Int?
  minInfants  Int?

  maxUses   Int?
  usedCount Int  @default(0)

  translations CampaignTranslation[]
  coupons      Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([isActive])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([packageId, status, startAt, endAt])
}

model CampaignTranslation {
  id         String @id @default(uuid())
  campaignId String
  lang       String

  promoName        String?
  promoDescription String?

  addIncludes    Json?
  removeIncludes Json?

  addExcludes    Json?
  removeExcludes Json?

  addNotes    Json?
  removeNotes Json?

  imageMediaId String?
  imageMedia   MediaAsset? @relation("CampaignCover", fields: [imageMediaId], references: [id], onDelete: SetNull)

  effectMode CampaignEffectMode @default(MERGE)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, lang])
}

model Reservation {
  id    String @id @default(uuid())
  folio String @unique

  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  visitDate DateTime
  adults    Int
  children  Int
  infants   Int

  firstName String?
  lastName  String?
  email     String?
  phone     String?
  country   String?
  comments  String?

  campaignCode         String?
  appliedCampaignCodes Json?
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  fbclid               String?
  ttclid               String?

  couponCode        String?
  couponDiscountMXN Int     @default(0)

  inapamVisitors    Int @default(0)
  inapamDiscountMXN Int @default(0)

  campaignDiscountMXN Int @default(0)
  discountMXN         Int @default(0)

  peopleSubtotalMXN Int @default(0)
  subtotalMXN       Int @default(0)
  extrasMXN         Int @default(0)
  totalMXN          Int @default(0)

  currency String @default("MXN")
  status   String @default("DRAFT")

  pricingBreakdown Json?

  snapshotLang        String?
  snapshotName        String?
  snapshotDescription String?
  snapshotIncludes    Json?
  snapshotExcludes    Json?
  snapshotNotes       Json?
  snapshotAgeRules    Json?

  extras   ReservationExtra[]
  payments Payment[]
  traces   ReservationTrace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folio])
  @@index([packageId])
  @@index([visitDate])
  @@index([createdAt])
}

model ReservationTrace {
  id            String  @id @default(uuid())
  reservationId String
  folio         String
  step          String
  message       String?
  metadata      Json?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reservationId])
  @@index([folio])
  @@index([createdAt])
  @@map("reservation_traces")
}

model ReservationExtra {
  id            String  @id @default(uuid())
  reservationId String
  extraId       String?

  code     String
  qty      Int    @default(1)
  priceMXN Int
  currency String @default("MXN")

  name        String?
  description String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reservationId])
  @@index([code])
}

model Payment {
  id            String @id @default(uuid())
  reservationId String
  provider      String
  method        String
  status        String @default("PENDING")

  amountMXN Int
  reference String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([status])
}

model Coupon {
  id   String @id @default(uuid())
  code String @unique

  type  CouponType
  value Int
  scope CouponScope

  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?
  maxUses  Int?
  uses     Int       @default(0)

  packageId  String?
  campaignId String?

  package  Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([packageId])
  @@index([campaignId])
  @@index([isActive])
}

model MediaAsset {
  id           String    @id @default(uuid())
  kind         MediaKind
  mimeType     String
  ext          String
  size         Int
  originalName String
  filename     String    @unique
  path         String
  url          String
  isActive     Boolean   @default(true)

  data Bytes?

  packageCoverOf     Package[]             @relation("PackageCover")
  campaignCoverOf    CampaignTranslation[] @relation("CampaignCover")
  heroCarouselSlides HeroCarouselSlide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroCarouselSlide {
  id        String   @id @default(uuid())
  mediaId   String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  title     String?
  subtitle  String?
  linkUrl   String?
  linkText  String?
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([order])
  @@index([isActive])
  @@map("hero_carousel_slides")
}

model ReservationEmailLog {
  id            String  @id @default(uuid())
  reservationId String
  folio         String
  type          String
  to            String
  subject       String
  status        String  @default("PENDING")
  provider      String  @default("RESEND")
  providerId    String?
  error         String?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([folio])
  @@index([status])
  @@map("reservation_email_logs")
}

model ReservationFolioSequence {
  id        String @id @default(uuid())
  dateKey   String @unique
  lastValue Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reservation_folio_sequences")
}

enum AgentConversationStatus {
  BOT_ACTIVE
  HUMAN_ACTIVE
  CLOSED
}

enum AgentMessageSender {
  CUSTOMER
  BOT
  HUMAN
  SYSTEM
}

enum AgentMessageChannel {
  WHATSAPP
  WEB
}

enum AgentMessageDirection {
  INBOUND
  OUTBOUND
}

model AgentConversation {
  id        String @id @default(uuid())
  sessionId String @unique

  channel AgentMessageChannel     @default(WHATSAPP)
  status  AgentConversationStatus @default(BOT_ACTIVE)

  botEnabled Boolean @default(true)
  humanMode  Boolean @default(false)

  assignedTo String?
  assignedAt DateTime?

  lastIntent      String?
  lastIntentScore Float?
  lastMessage     String?
  matchedWords    Json?

  packageCode String?
  visitDate   String?
  adults      Int?
  children    Int?
  infants     Int?

  customerName  String?
  customerEmail String?
  customerPhone String?

  lastCustomerAt DateTime?
  lastBotAt      DateTime?
  lastHumanAt    DateTime?

  metadata Json?

  messages AgentConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([botEnabled])
  @@index([humanMode])
  @@index([packageCode])
  @@index([lastCustomerAt])
  @@map("agent_conversations")
}

model AgentConversationMessage {
  id             String @id @default(uuid())
  conversationId String

  sender    AgentMessageSender
  channel   AgentMessageChannel   @default(WHATSAPP)
  direction AgentMessageDirection

  message String

  intent      String?
  intentScore Float?

  packageCode String?
  metadata    Json?

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([sender])
  @@index([direction])
  @@index([intent])
  @@index([createdAt])
  @@map("agent_conversation_messages")
}

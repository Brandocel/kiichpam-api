generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

/// Roles del panel administrativo interno.
/// Independiente de UserRole (que aplica a clientes finales).
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES
  ACCOUNTING
  VIEWER
  AUDITOR
}

/// Tipo de agente de reservas. Sirve para agrupar comisiones y para
/// derivar el origen comercial de la venta (Hotel, Taxis, Agencias...).
enum SalesAgentType {
  INTERNAL
  HOTEL
  TAXI
  AGENCY
  INFLUENCER
  OTHER
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  PACKAGE_ONLY
  CAMPAIGN_ONLY
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum CampaignStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  DISABLED
}

enum CampaignRuleType {
  BASE_PRICE
  FIXED_PRICE
  PERCENT_DISCOUNT
  TWO_FOR_ONE
  THREE_FOR_TWO
}

enum CampaignAudience {
  ADULT
  CHILD
  INFANT
  ALL
}

enum CampaignCategory {
  PRICE
  CONTENT
  MIXED
}

enum CampaignEffectMode {
  MERGE
  REPLACE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Usuarios internos del panel administrativo.
/// El password se guarda hasheado (scrypt) y nunca se expone en las respuestas.
model AdminUser {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      AdminRole @default(VIEWER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("admin_user")
}

/// Agente de reservas: hotel, taxista, agencia, influencer o vendedor interno.
/// Cada agente tiene un `code` único con el que se arma su link de venta
/// (`/reservar?ag=CODE`). No inicia sesión en el panel: es una entidad pasiva
/// que solo sirve para atribuir la venta y calcular su comisión.
model SalesAgent {
  id   String @id @default(uuid())
  code String @unique

  /// Token opaco que viaja en el link público (`/reservar?ag=KX7F2MQD`).
  /// Existe para que el nombre del agente no quede expuesto en la URL que ve
  /// el cliente. Se puede regenerar si un link se filtra; `code` sigue
  /// resolviendo para no romper links ya repartidos.
  linkToken String @unique

  name    String
  email   String?
  phone   String?
  company String?

  type SalesAgentType @default(INTERNAL)

  /// Porcentaje de comisión sobre el total de la reservación pagada.
  /// Se copia a la reservación al momento de la venta para que un cambio
  /// posterior no altere el histórico.
  commissionPercent Float @default(0)

  isActive Boolean @default(true)
  notes    String?

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([linkToken])
  @@index([isActive])
  @@index([type])
  @@map("sales_agents")
}

model Package {
  id      String @id @default(uuid())
  webCode Int    @unique @default(dbgenerated("nextval('package_web_code_seq'::regclass)")) @map("codigoweb")

  code             String                   @unique
  isActive         Boolean                  @default(true)
  promotionOptions PromotionPackageOption[]

  adultPriceMXN  Int
  childPriceMXN  Int  @default(0)
  infantPriceMXN Int  @default(0)
  inapamPriceMXN Int?

  currency String @default("MXN")

  maxAdults   Int?
  maxChildren Int?
  maxInfants  Int?

  ageRules Json?

  translations PackageTranslation[]
  extras       PackageExtra[]
  campaigns    Campaign[]
  reservations Reservation[]
  coupons      Coupon[]
  promotions   Promotion[]

  coverMediaId String?
  coverMedia   MediaAsset? @relation("PackageCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PackageTranslation {
  id          String  @id @default(uuid())
  packageId   String
  lang        String
  name        String
  description String?

  includes Json?
  excludes Json?
  notes    Json?

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, lang])
}

model PackageExtra {
  id         String  @id @default(uuid())
  packageId  String
  code       String
  priceMXN   Int
  currency   String  @default("MXN")
  isRequired Boolean @default(false)
  isActive   Boolean @default(true)

  translations PackageExtraTranslation[]
  package      Package                   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, code])
}

model PackageExtraTranslation {
  id          String  @id @default(uuid())
  extraId     String
  lang        String
  name        String
  description String?

  extra PackageExtra @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@unique([extraId, lang])
}

model Campaign {
  id               String                   @id @default(uuid())
  code             String                   @unique
  name             String
  source           String?
  isActive         Boolean                  @default(true)
  promotions       Promotion[]
  promotionOptions PromotionPackageOption[]

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  description String?

  status   CampaignStatus   @default(SCHEDULED)
  category CampaignCategory @default(PRICE)
  ruleType CampaignRuleType @default(BASE_PRICE)
  audience CampaignAudience @default(ALL)

  startAt DateTime?
  endAt   DateTime?

  priority  Int     @default(0)
  autoApply Boolean @default(true)
  stackable Boolean @default(false)

  fixedAdultPriceMXN  Int?
  fixedChildPriceMXN  Int?
  fixedInfantPriceMXN Int?
  fixedInapamPriceMXN Int?

  discountPercent Int?

  payQty  Int?
  takeQty Int?

  minAdults   Int?
  minChildren Int?
  minInfants  Int?

  maxUses   Int?
  usedCount Int  @default(0)

  translations CampaignTranslation[]
  coupons      Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([isActive])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([packageId, status, startAt, endAt])
}

model CampaignTranslation {
  id         String @id @default(uuid())
  campaignId String
  lang       String

  promoName        String?
  promoDescription String?

  addIncludes    Json?
  removeIncludes Json?

  addExcludes    Json?
  removeExcludes Json?

  addNotes    Json?
  removeNotes Json?

  imageMediaId String?
  imageMedia   MediaAsset? @relation("CampaignCover", fields: [imageMediaId], references: [id], onDelete: SetNull)

  effectMode CampaignEffectMode @default(MERGE)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, lang])
}

model Reservation {
  id    String @id @default(uuid())
  folio String @unique

  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  visitDate DateTime
  adults    Int
  children  Int
  infants   Int

  firstName String?
  lastName  String?
  email     String?
  phone     String?
  country   String?
  comments  String?

  campaignCode         String?
  appliedCampaignCodes Json?

  reference   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  ttclid      String?
  gclid       String?
  landingPage String?
  referrer    String?

  /// Agente de reservas que trajo la venta. Es una dimensión aparte del
  /// `reference`/UTM: el canal sigue siendo el canal (Google, Facebook...) y
  /// el agente indica quién cerró. `salesAgentCode` y
  /// `agentCommissionPercent` son snapshots para que el histórico sobreviva
  /// si el agente se borra o cambia su comisión.
  salesAgentId           String?
  salesAgentCode         String?
  agentCommissionPercent Float?
  salesAgent             SalesAgent? @relation(fields: [salesAgentId], references: [id], onDelete: SetNull)

  couponCode        String?
  couponDiscountMXN Int     @default(0)

  inapamVisitors    Int @default(0)
  inapamDiscountMXN Int @default(0)

  campaignDiscountMXN Int @default(0)
  discountMXN         Int @default(0)

  peopleSubtotalMXN Int @default(0)
  subtotalMXN       Int @default(0)
  extrasMXN         Int @default(0)
  totalMXN          Int @default(0)

  /// Suma de los pagos liquidados, en centavos. Se recalcula desde la tabla
  /// Payment cada vez que se registra un movimiento, así que es un
  /// denormalizado seguro: la fuente de verdad siguen siendo los pagos.
  /// El saldo es totalMXN - paidMXN.
  paidMXN Int @default(0)

  currency String @default("MXN")
  status   String @default("DRAFT")

  pricingBreakdown Json?

  snapshotLang        String?
  snapshotName        String?
  snapshotDescription String?
  snapshotIncludes    Json?
  snapshotExcludes    Json?
  snapshotNotes       Json?
  snapshotAgeRules    Json?

  extras   ReservationExtra[]
  payments Payment[]
  traces   ReservationTrace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folio])
  @@index([packageId])
  @@index([visitDate])
  @@index([createdAt])
  @@index([reference])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([salesAgentId])
  @@index([salesAgentCode])
}

model ReservationTrace {
  id            String  @id @default(uuid())
  reservationId String
  folio         String
  step          String
  message       String?
  metadata      Json?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reservationId])
  @@index([folio])
  @@index([createdAt])
  @@map("reservation_traces")
}

model ReservationExtra {
  id            String  @id @default(uuid())
  reservationId String
  extraId       String?

  code     String
  qty      Int    @default(1)
  priceMXN Int
  currency String @default("MXN")

  name        String?
  description String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reservationId])
  @@index([code])
}

model Payment {
  id            String @id @default(uuid())
  reservationId String
  provider      String
  method        String
  status        String @default("PENDING")

  /// FULL = cobro del total. DEPOSIT = anticipo o pago parcial.
  /// ONSITE = liquidación cobrada en el cenote (efectivo o terminal).
  kind String @default("FULL")

  amountMXN Int
  reference String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reservationId, reference])
  @@index([reservationId])
  @@index([status])
}

model Coupon {
  id   String @id @default(uuid())
  code String @unique

  type  CouponType
  value Int
  scope CouponScope

  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?
  maxUses  Int?
  uses     Int       @default(0)

  packageId  String?
  campaignId String?

  package  Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([packageId])
  @@index([campaignId])
  @@index([isActive])
}

model MediaAsset {
  id              String      @id @default(uuid())
  kind            MediaKind
  mimeType        String
  ext             String
  size            Int
  originalName    String
  filename        String      @unique
  path            String
  url             String
  isActive        Boolean     @default(true)
  promotionImages Promotion[]

  data Bytes?

  packageCoverOf     Package[]             @relation("PackageCover")
  campaignCoverOf    CampaignTranslation[] @relation("CampaignCover")
  heroCarouselSlides HeroCarouselSlide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroCarouselSlide {
  id       String  @id @default(uuid())
  mediaId  String
  order    Int     @default(0)
  isActive Boolean @default(true)

  // Campos actuales.
  // Déjalos para no romper datos existentes y usarlos como fallback.
  title    String?
  subtitle String?
  linkUrl  String?
  linkText String?
  altText  String?

  media        MediaAsset                     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  translations HeroCarouselSlideTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@map("hero_carousel_slides")
}

model HeroCarouselSlideTranslation {
  id      String @id @default(uuid())
  slideId String
  lang    String

  title    String?
  subtitle String?
  linkText String?
  altText  String?

  slide HeroCarouselSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slideId, lang])
  @@index([slideId])
  @@index([lang])
  @@map("hero_carousel_slide_translations")
}

model ReservationEmailLog {
  id            String  @id @default(uuid())
  reservationId String
  folio         String
  type          String
  to            String
  subject       String
  status        String  @default("PENDING")
  provider      String  @default("RESEND")
  providerId    String?
  error         String?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([folio])
  @@index([status])
  @@map("reservation_email_logs")
}

model ReservationFolioSequence {
  id        String @id @default(uuid())
  dateKey   String @unique
  lastValue Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reservation_folio_sequences")
}

enum AgentConversationStatus {
  BOT_ACTIVE
  HUMAN_ACTIVE
  CLOSED
}

enum AgentMessageSender {
  CUSTOMER
  BOT
  HUMAN
  SYSTEM
}

enum AgentMessageChannel {
  WHATSAPP
  WEB
}

enum AgentMessageDirection {
  INBOUND
  OUTBOUND
}

model AgentConversation {
  id        String @id @default(uuid())
  sessionId String @unique

  channel AgentMessageChannel     @default(WHATSAPP)
  status  AgentConversationStatus @default(BOT_ACTIVE)

  botEnabled Boolean @default(true)
  humanMode  Boolean @default(false)

  assignedTo String?
  assignedAt DateTime?

  lastIntent      String?
  lastIntentScore Float?
  lastMessage     String?
  matchedWords    Json?

  packageCode String?
  visitDate   String?
  adults      Int?
  children    Int?
  infants     Int?

  customerName  String?
  customerEmail String?
  customerPhone String?

  lastCustomerAt DateTime?
  lastBotAt      DateTime?
  lastHumanAt    DateTime?

  metadata Json?

  messages AgentConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([botEnabled])
  @@index([humanMode])
  @@index([packageCode])
  @@index([lastCustomerAt])
  @@map("agent_conversations")
}

model AgentConversationMessage {
  id             String @id @default(uuid())
  conversationId String

  sender    AgentMessageSender
  channel   AgentMessageChannel   @default(WHATSAPP)
  direction AgentMessageDirection

  message String

  intent      String?
  intentScore Float?

  packageCode String?
  metadata    Json?

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([sender])
  @@index([direction])
  @@index([intent])
  @@index([createdAt])
  @@map("agent_conversation_messages")
}

enum PromotionSectionType {
  MONTHLY
  STANDARD
}

model Promotion {
  id String @id @default(uuid())

  code           String                   @unique
  isActive       Boolean                  @default(true)
  packageOptions PromotionPackageOption[]

  sectionType PromotionSectionType @default(STANDARD)

  title       String
  subtitle    String?
  description String?

  buttonText String?
  buttonUrl  String?

  order    Int @default(0)
  priority Int @default(0)

  startAt DateTime?
  endAt   DateTime?

  packageId    String?
  campaignId   String?
  imageMediaId String?

  package    Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  imageMedia MediaAsset? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)

  translations PromotionTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sectionType])
  @@index([startAt])
  @@index([endAt])
  @@index([order])
  @@index([priority])
  @@index([packageId])
  @@index([campaignId])
  @@index([imageMediaId])
  @@map("promotions")
}

model PromotionTranslation {
  id          String @id @default(uuid())
  promotionId String
  lang        String

  title       String?
  subtitle    String?
  description String?
  buttonText  String?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promotionId, lang])
  @@index([promotionId])
  @@index([lang])
  @@map("promotion_translations")
}

model PromotionPackageOption {
  id String @id @default(uuid())

  promotionId String
  packageId   String
  campaignId  String?

  label       String?
  description String?

  displayPriceMXN Int?
  order           Int     @default(0)
  isActive        Boolean @default(true)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  package   Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([promotionId])
  @@index([packageId])
  @@index([campaignId])
  @@index([isActive])
  @@index([order])
  @@map("promotion_package_options")
}
